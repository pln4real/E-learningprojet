# Copie ce fichier en ".env.local" et remplis avec tes vraies valeurs
# (Supabase → Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ta_cle_anon_publique_ici

# ---- Paiement et abonnements (variables SERVEUR : à mettre dans Vercel, JAMAIS sur GitHub) ----
# Adresse publique du site (sert aux liens de retour du paiement)
NEXT_PUBLIC_SITE_URL=https://ton-site.vercel.app
# Supabase -> Project Settings -> API -> clé « service_role » (SECRÈTE)
SUPABASE_SERVICE_ROLE_KEY=
# PayDunya -> tableau de bord -> Intégrer -> clés de l'application
PAYDUNYA_MODE=test            # « test » pour essayer sans argent, puis « live »
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
